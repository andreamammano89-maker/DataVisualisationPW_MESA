    "def gini(values):\n",
    "    sorted_vals = np.sort(values)\n",
    "    n = len(sorted_vals)\n",
    "    cumulative = np.cumsum(sorted_vals)\n",
    "    return (2 * np.sum((np.arange(1, n+1) * sorted_vals)) \n",
    "            / (n * cumulative[-1])) - (n + 1) / n\n",
    "\n",
    "for city in [\"Rome\", \"Copenhagen\"]:\n",
    "    host_data = (\n",
    "        df[df[\"city\"] == city]\n",
