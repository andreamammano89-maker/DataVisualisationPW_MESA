    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.colors as mcolors\n",
    "import pandas as pd\n",
    "\n",
    "# ── DATA ─────────────────────────────────────────────────────────────────────\n",
    "df = pd.read_csv('data/export/neighbourhood_upi.csv')\n",
    "rome = df[df['city'] == 'Rome'].sort_values('avg_availability').reset_index(drop=True)\n",
    "cph  = df[df['city'] == 'Copenhagen'].sort_values('avg_availability').reset_index(drop=True)\n",
    "\n",
    "BG   = 'white'\n",
    "cmap = mcolors.LinearSegmentedColormap.from_list('proShare', ['#27ae60', '#f39c12', '#c0392b'])\n",
    "norm = mcolors.Normalize(vmin=0, vmax=40)\n",
    "\n",
    "# ── FIGURE: layout fisso con gridspec ────────────────────────────────────────\n",
    "# Righe: [grafico Roma] [xlabel Roma] [gap] [colorbar] [gap] [grafico CPH] [xlabel CPH]\n",
    "fig = plt.figure(figsize=(24, 22), facecolor=BG)\n",
    "\n",
    "# Usiamo subplot2grid manuale con altezze precise\n",
    "# top/bottom del figure ben definiti\n",
    "fig.subplots_adjust(left=0.08, right=0.96, top=0.91, bottom=0.05)\n",
    "\n",
    "# Posizioni manuali assolute in figure fraction [left, bottom, width, height]\n",
    "# Roma: occupa la metà superiore\n",
    "ax1 = fig.add_axes([0.08, 0.54, 0.88, 0.35])\n",
    "# Copenhagen: occupa la metà inferiore\n",
    "ax2 = fig.add_axes([0.08, 0.10, 0.88, 0.35])\n",
    "# Colorbar: striscia stretta esattamente a metà tra i due grafici\n",
    "ax_cb = fig.add_axes([0.25, 0.475, 0.50, 0.018])\n",
    "\n",
    "\n",
    "# ── DRAW FUNCTION ─────────────────────────────────────────────────────────────\n",
    "def draw_stripes(ax, data, city_name, city_color):\n",
    "    n     = len(data)\n",
    "    max_h = data['avg_availability'].max()\n",
    "\n",
    "    ax.set_facecolor(BG)\n",
    "    for spine in ['top', 'right', 'bottom']:\n",
    "        ax.spines[spine].set_visible(False)\n",
    "    ax.spines['left'].set_color('#dddddd')\n",
    "    ax.spines['left'].set_linewidth(1)\n",
    "\n",
    "    # Bars\n",
    "    for i, row in data.iterrows():\n",
    "        color = cmap(norm(row['professional_share']))\n",
    "        h     = row['avg_availability']\n",
    "        ax.bar(i, h, width=0.75, color=color, linewidth=0, zorder=2)\n",
    "        ax.text(i, h + max_h * 0.025, f\"{int(h)}\",\n",
    "                fontsize=11, color='#1a1a1a', ha='center', va='bottom', fontweight='bold')\n",
    "\n",
    "    # Y axis\n",
    "    grid_vals = [y for y in [50, 100, 150, 200, 250, 300] if y <= max_h]\n",
    "    for y in grid_vals:\n",
    "        ax.axhline(y, color='#eeeeee', linewidth=0.9, zorder=0)\n",
    "    ax.set_yticks(grid_vals)\n",
    "    ax.set_yticklabels([str(y) for y in grid_vals], fontsize=11, color='#666666')\n",
    "    ax.tick_params(axis='y', length=0, pad=5)\n",
    "\n",
    "    # X axis — nomi quartieri\n",
    "    ax.set_xticks(range(n))\n",
    "    ax.set_xticklabels(data['neighbourhood'],\n",
    "                       rotation=35, ha='right', fontsize=11, color='#222222')\n",
    "    ax.tick_params(axis='x', length=0, pad=4)\n",
    "\n",
    "    ax.set_xlim(-0.6, n - 0.4)\n",
    "    ax.set_ylim(0, max_h * 1.28)\n",
    "\n",
    "    # Labels assi\n",
    "    ax.set_ylabel('Days listed per year', fontsize=12, fontweight='bold',\n",
    "                  color='#333333', labelpad=10)\n",
    "    ax.set_xlabel('Neighbourhoods ordered by avg days listed  (low → high)',\n",
    "                  fontsize=12, fontweight='bold', color='#333333', labelpad=12)\n",
    "\n",
    "    # City badge\n",
    "    ax.text(0.005, 0.99, city_name, fontsize=15, fontweight='bold',\n",
    "            color=city_color, va='top', ha='left', transform=ax.transAxes,\n",
    "            bbox=dict(boxstyle='round,pad=0.3', facecolor='white',\n",
    "                      edgecolor=city_color, linewidth=2))\n",
    "\n",
    "\n",
    "draw_stripes(ax1, rome, 'Rome',       '#E8743B')\n",
    "draw_stripes(ax2, cph,  'Copenhagen', '#2980b9')\n",
    "\n",
    "# ── COLORBAR ─────────────────────────────────────────────────────────────────\n",
    "sm = plt.cm.ScalarMappable(cmap=cmap, norm=mcolors.Normalize(0, 40))\n",
    "sm.set_array([])\n",
    "cb = fig.colorbar(sm, cax=ax_cb, orientation='horizontal')\n",
    "cb.set_ticks([0, 10, 20, 30, 40])\n",
    "cb.set_ticklabels(['0%', '10%', '20%', '30%', '40%'])\n",
    "cb.ax.xaxis.set_tick_params(labelsize=11, length=0)\n",
    "plt.setp(cb.ax.xaxis.get_ticklabels(), color='#333333', fontsize=11)\n",
    "cb.outline.set_edgecolor('#aaaaaa')\n",
    "\n",
    "# Titolo colorbar\n",
    "fig.text(0.50, 0.500, 'Professional host share per neighbourhood',\n",
    "         fontsize=12, fontweight='bold', color='#333333', ha='center', va='bottom')\n",
    "\n",
    "# Annotazioni laterali colorbar (sinistra e destra, stessa y della barra)\n",
    "fig.text(0.235, 0.484, '← low',\n",
    "         fontsize=11, color='#27ae60', ha='right', va='center', fontweight='bold')\n",
    "fig.text(0.765, 0.484, 'high →',\n",
    "         fontsize=11, color='#c0392b', ha='left', va='center', fontweight='bold')\n",
    "\n",
    "# ── TITOLO FIGURA ─────────────────────────────────────────────────────────────\n",
    "fig.text(0.5, 0.955, 'Airbnb Pressure Stripes',\n",
    "         fontsize=30, fontweight='bold', color='#111111',\n",
    "         ha='center', fontfamily='serif')\n",
    "fig.text(0.5, 0.924,\n",
    "         'Height = avg days listed per year on Airbnb   ·   '\n",
    "         'Color = share of listings controlled by professional hosts (5+ listings)',\n",
    "         fontsize=12, color='#666666', ha='center')\n",
    "\n",
    "plt.savefig('data/export/creative_viz_stripes.png',\n",
    "            dpi=180, bbox_inches='tight', facecolor=BG)\n",
    "plt.show()\n",
    "print(\"✅ Salvato: data/export/creative_viz_stripes.png\")"
   ]
  },
